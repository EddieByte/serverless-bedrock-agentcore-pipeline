# =============================================================================
# SECRETS & CREDENTIALS
# =============================================================================
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.ppk

# Environment variable files
.env
.env.*
!.env.example
!.env.sample

# AWS credentials / config
.aws/
credentials
aws-credentials.json

# Any file named secrets
secrets.*
*secrets*
*credentials*
*password*
*passwd*
*apikey*
*api_key*
*api-key*
*token*
!*token_type*

# =============================================================================
# TERRAFORM
# =============================================================================

# Local variable overrides — may contain real secrets/ARNs
terraform.tfvars
*.auto.tfvars

# State files — contain all resource details including sensitive outputs
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform working directories
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Packaged Lambda ZIP (generated at apply time, not source)
lambda_payload.zip
*.zip

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config file
.terraformrc
terraform.rc

# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.Python

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# =============================================================================
# OS & EDITOR
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code / Kiro
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml

# =============================================================================
# LOGS & TEMP FILES
# =============================================================================
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# Test output
test_data.csv
analysis_report.md
